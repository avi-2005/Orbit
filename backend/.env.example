# OpenSky (opensky-network.org -> account -> API Client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Google Gemini API key - free tier, no card required
# Get one at aistudio.google.com/apikey
# Powers the /api/ask copilot endpoint
GEMINI_API_KEY=

# aisstream.io API key - free, sign up at aisstream.io
# Powers live ship tracking. Leave blank to disable ships (everything
# else still works fine without it).
AISSTREAM_API_KEY=
