# Flights: no key needed! Uses airplanes.live (a community ADS-B feed
# that, unlike OpenSky, doesn't block cloud/datacenter IPs).

# Google Gemini API key - free tier, no card required
# Get one at aistudio.google.com/apikey
# Powers the /api/ask copilot endpoint
GEMINI_API_KEY=

# OpenWeatherMap API key - free tier (60 calls/min, 1M/month), no card
# Get one at openweathermap.org/api
OPENWEATHER_API_KEY=

# aisstream.io API key - free, sign up at aisstream.io
# Powers live ship tracking. Leave blank to disable ships (everything
# else still works fine without it). Their service has had reliability
# issues (SSL cert expiry, login outages) as of mid-2026 - if signup is
# broken, that's on their end, retry later.
AISSTREAM_API_KEY=
